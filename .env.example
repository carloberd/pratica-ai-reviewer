# Credenziali OAuth 2.0 del client di tipo "Applicazione desktop" creato nella Google
# Cloud Console (vedi README, sezione "Setup Google Cloud"). Il tipo desktop accetta il
# redirect su http://127.0.0.1:<porta> senza doverlo registrare.
#
# Copiare questo file in `.env`, che resta fuori da git. Nell'app impacchettata lo
# stesso file va nella cartella dati dell'utente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
