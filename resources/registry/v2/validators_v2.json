{
  "version": "2.0.0",
  "validators": {
    "non_empty": {
      "kind": "builtin",
      "severity": "error"
    },
    "valid_date": {
      "kind": "builtin",
      "severity": "error"
    },
    "non_negative_money": {
      "kind": "builtin",
      "severity": "error"
    },
    "iban_checksum": {
      "kind": "builtin",
      "severity": "error"
    },
    "tax_id_format": {
      "kind": "builtin",
      "severity": "warning"
    },
    "vat_number_format": {
      "kind": "builtin",
      "severity": "warning"
    },
    "italian_tax_code_format": {
      "kind": "builtin",
      "severity": "warning"
    },
    "vehicle_plate": {
      "kind": "regex",
      "pattern": "^[A-Z]{2}[0-9]{3}[A-Z]{2}$",
      "severity": "warning"
    },
    "vin": {
      "kind": "regex",
      "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
      "severity": "warning"
    }
  },
  "cross_field_rules": [
    {
      "id": "date_order_contract",
      "if_present": [
        "contract.start_date",
        "contract.end_date"
      ],
      "rule": "contract.end_date >= contract.start_date",
      "severity": "error"
    },
    {
      "id": "date_order_coverage",
      "if_present": [
        "insurance.coverage_start",
        "insurance.coverage_end"
      ],
      "rule": "insurance.coverage_end >= insurance.coverage_start",
      "severity": "error"
    },
    {
      "id": "date_order_employment",
      "if_present": [
        "employment.start_date",
        "employment.end_date"
      ],
      "rule": "employment.end_date >= employment.start_date",
      "severity": "error"
    },
    {
      "id": "invoice_total_check",
      "if_present": [
        "money.taxable",
        "money.tax",
        "money.total"
      ],
      "rule": "abs((money.taxable + money.tax) - money.total) <= 0.05",
      "severity": "warning"
    },
    {
      "id": "installment_math",
      "applies_when_field": "finance.installments",
      "rule": "for each item: amount ~= principal + interest",
      "severity": "warning"
    }
  ]
}